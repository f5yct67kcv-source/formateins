{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "1120px", "wideSize": "1360px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "kreide", "name": "Kreide", "color": "#f4f2eb" },
        { "slug": "weiss", "name": "Weiss", "color": "#ffffff" },
        { "slug": "anthrazit", "name": "Anthrazit", "color": "#1c201e" },
        { "slug": "schiefer", "name": "Schiefer", "color": "#4a504c" },
        { "slug": "linie", "name": "Linie", "color": "#d9d5c8" },
        { "slug": "platz", "name": "Platzgruen", "color": "#1e6b45" },
        { "slug": "platz-dunkel", "name": "Platzgruen dunkel", "color": "#124a2f" },
        { "slug": "ball", "name": "Ball", "color": "#dff04a" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "barlow", "name": "Barlow", "fontFamily": "Barlow, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Barlow", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-latin-400-normal.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-latin-400-italic.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-latin-500-normal.woff2"] },
            { "fontFamily": "Barlow", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-latin-600-normal.woff2"] }
          ]
        },
        {
          "slug": "condensed", "name": "Barlow Condensed", "fontFamily": "'Barlow Condensed', 'Arial Narrow', sans-serif",
          "fontFace": [
            { "fontFamily": "Barlow Condensed", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-500-normal.woff2"] },
            { "fontFamily": "Barlow Condensed", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-600-normal.woff2"] },
            { "fontFamily": "Barlow Condensed", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/barlow-condensed-latin-700-normal.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "klein", "name": "Klein", "size": "0.9rem", "fluid": false },
        { "slug": "normal", "name": "Normal", "size": "1.0625rem", "fluid": false },
        { "slug": "gross", "name": "Gross", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
        { "slug": "titel", "name": "Titel", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
        { "slug": "hero", "name": "Hero", "size": "4rem", "fluid": { "min": "2.75rem", "max": "5.5rem" } },
        { "slug": "zahl", "name": "Zahl", "size": "5rem", "fluid": { "min": "3.5rem", "max": "6rem" } }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.5rem" },
        { "slug": "20", "name": "2", "size": "1rem" },
        { "slug": "30", "name": "3", "size": "1.5rem" },
        { "slug": "40", "name": "4", "size": "2.5rem" },
        { "slug": "50", "name": "5", "size": "clamp(3rem, 6vw, 5rem)" },
        { "slug": "60", "name": "6", "size": "clamp(4rem, 9vw, 7.5rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--kreide)", "text": "var(--wp--preset--color--anthrazit)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--barlow)", "fontSize": "var(--wp--preset--font-size--normal)", "lineHeight": "1.55" },
    "spacing": { "padding": { "left": "var(--wp--preset--spacing--30)", "right": "var(--wp--preset--spacing--30)" }, "blockGap": "1.25rem" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontWeight": "600", "lineHeight": "1.02", "letterSpacing": "-0.01em" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--hero)", "fontWeight": "700" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--titel)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--gross)", "fontFamily": "var(--wp--preset--font-family--barlow)", "fontWeight": "600", "lineHeight": "1.25", "letterSpacing": "0" } },
      "link": { "color": { "text": "var(--wp--preset--color--platz)" }, ":hover": { "color": { "text": "var(--wp--preset--color--platz-dunkel)" } } },
      "button": {
        "color": { "background": "var(--wp--preset--color--anthrazit)", "text": "var(--wp--preset--color--kreide)" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontWeight": "600", "fontSize": "1.125rem", "letterSpacing": "0.02em", "textTransform": "uppercase" },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--platz)", "text": "var(--wp--preset--color--kreide)" } }
      }
    },
    "blocks": {
      "core/button": { "variations": { "outline": { "color": { "text": "var(--wp--preset--color--anthrazit)" }, "border": { "width": "2px" } } } },
      "core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--condensed)", "fontWeight": "700", "fontSize": "1.5rem", "textTransform": "uppercase", "letterSpacing": "0.02em" }, "elements": { "link": { "color": { "text": "inherit" }, "typography": { "textDecoration": "none" } } } },
      "core/navigation": { "typography": { "fontWeight": "500", "fontSize": "1rem" } },
      "core/post-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--barlow)", "fontWeight": "600", "lineHeight": "1.2" } },
      "core/post-date": { "typography": { "fontSize": "var(--wp--preset--font-size--klein)" }, "color": { "text": "var(--wp--preset--color--schiefer)" } },
      "core/table": { "typography": { "fontSize": "var(--wp--preset--font-size--normal)" } },
      "core/separator": { "color": { "text": "var(--wp--preset--color--linie)" } }
    }
  },
  "customTemplates": [
    { "name": "startseite-halle", "title": "Startseite: Halle", "postTypes": ["page"] },
    { "name": "startseite-tafel", "title": "Startseite: Tafel", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Kopf", "area": "header" },
    { "name": "footer", "title": "Fuss", "area": "footer" },
    { "name": "hinweis", "title": "Hinweis-Leiste", "area": "uncategorized" }
  ]
}
